{
  "name": "@mcp-contracts/cli",
  "version": "0.7.0",
  "description": "CLI tool for capturing and diffing MCP tool schemas",
  "type": "module",
  "bin": {
    "mcpdiff": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm run build && pnpm run test"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@mcp-contracts/core": "workspace:*",
    "@mcp-contracts/test": "workspace:^",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "cli-table3": "^0.6.0",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsup": "^8.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "cli",
    "schema",
    "diff",
    "mcpdiff"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mcp-contracts/mcp-contracts",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/mcp-contracts/mcp-contracts#readme",
  "bugs": {
    "url": "https://github.com/mcp-contracts/mcp-contracts/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}

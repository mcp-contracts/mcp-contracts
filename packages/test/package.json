{
  "name": "@mcp-contracts/test",
  "version": "0.7.2",
  "description": "Contract conformance testing for MCP servers",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./matchers": {
      "types": "./dist/matchers.d.ts",
      "import": "./dist/matchers.js"
    }
  },
  "bin": {
    "mcp-test": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm run build && pnpm run test"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@mcp-contracts/core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsup": "^8.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "vitest": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "contract-testing",
    "schema-validation",
    "mcp-test"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mcp-contracts/mcp-contracts",
    "directory": "packages/test"
  },
  "homepage": "https://github.com/mcp-contracts/mcp-contracts#readme",
  "bugs": {
    "url": "https://github.com/mcp-contracts/mcp-contracts/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
